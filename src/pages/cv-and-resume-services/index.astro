---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CV_TEMPLATES, SIMPLE_CV_EXAMPLE, WHATSAPP_NUMBER } from '../../lib/cv-templates';

function waLink(message: string) {
  return `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
}

// Links land on the /cv-builder/ plan chooser (carrying the chosen template through) rather than
// guessing a tier — the tiers are now segmented by seniority (0-2yrs vs 8+yrs etc.), so a design
// on its own doesn't tell us which plan fits; letting the customer pick avoids selling e.g. a
// "Fresh Graduate CV" template into the KES 12,500 senior/relocation tier.
const simpleTierOrderHref = `/cv-builder/?template=${SIMPLE_CV_EXAMPLE.id}`;
const genericWaLink = waLink('Hi! I am interested in getting a professional CV done through JobVacancy.co.ke. Can you help me?');

const title = 'CV & Resume Writing Services in Kenya — Professional CV Writers | JobVacancy.co.ke';
const description =
  'Browse real CV and resume design templates for every industry in Kenya. Pick a style and we\'ll write and design an ATS-optimized CV for you, delivered as PDF or Word.';
---

<Layout title={title} description={description} path="/cv-and-resume-services/">
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'CV & Resume Services', href: '/cv-builder/' }, { name: 'CV Designs' }]} />

  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-2xl font-extrabold text-brand-dark sm:text-3xl">Professional CV &amp; Resume Writing Services in Kenya</h1>
      <p class="mt-3 text-slate-600">
        A strong CV gets you shortlisted. Our writers put together a clean, professional, ATS-friendly CV or resume
        tailored to the jobs you're applying for — browse real CV examples and resume templates below, pick a
        style, then continue to build your CV.
      </p>
      <a href="/cv-builder/" class="mt-4 inline-block text-sm font-semibold text-brand-orange hover:underline">&larr; Back to Plans &amp; Pricing</a>
    </div>

    <!-- Simple CV example -->
    <section class="mt-14">
      <h2 class="text-xl font-bold text-brand-dark">Simple CV — What It Looks Like</h2>
      <p class="mt-1 text-sm text-slate-500">Clean, professional, no colours or design theme — just a well-structured CV.</p>
      <div class="mt-5 max-w-xs">
        <button
          type="button"
          class="cv-card-trigger group block w-full cursor-zoom-in overflow-hidden rounded-xl border border-border bg-white shadow-sm"
          data-image={SIMPLE_CV_EXAMPLE.image}
          data-title={SIMPLE_CV_EXAMPLE.title}
          data-wa={simpleTierOrderHref}
        >
          <div class="aspect-[3/4] overflow-hidden bg-cream">
            <img
              src={SIMPLE_CV_EXAMPLE.image}
              alt={SIMPLE_CV_EXAMPLE.title}
              loading="lazy"
              class="h-full w-full object-cover object-top transition-transform group-hover:scale-105"
            />
          </div>
          <p class="p-3 text-left text-sm font-semibold text-brand-dark">Click to preview &amp; scroll</p>
        </button>
      </div>
    </section>

    <!-- Themed template gallery -->
    <section id="themed-templates" class="mt-14 scroll-mt-20">
      <h2 class="text-xl font-bold text-brand-dark">Themed CV Templates — Pick Your Style</h2>
      <p class="mt-1 text-sm text-slate-500">
        Click any CV example to view it full-size, then continue to build your CV in that style.
      </p>

      <div class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {CV_TEMPLATES.map((t) => {
          const orderLink = `/cv-builder/?template=${t.id}`;
          return (
            <div class="card flex flex-col overflow-hidden">
              <button
                type="button"
                class="cv-card-trigger group block cursor-zoom-in overflow-hidden"
                data-image={t.image}
                data-title={`${t.title} (${t.id})`}
                data-wa={orderLink}
              >
                <div class="relative aspect-[3/4] overflow-hidden bg-cream">
                  <img
                    src={t.image}
                    alt={t.title}
                    loading="lazy"
                    class="h-full w-full object-cover object-top transition-transform group-hover:scale-105"
                  />
                  <span class="badge absolute right-2 top-2 bg-brand-dark/80 text-[10px] text-white">{t.id}</span>
                </div>
              </button>
              <div class="flex flex-1 flex-col p-3">
                <p class="text-sm font-semibold leading-tight text-brand-dark">{t.title}</p>
                <div class="mt-1.5 flex flex-wrap gap-1">
                  <span class="badge bg-brand-dark/5 text-[10px] text-brand-dark">{t.industry}</span>
                  <span class="badge bg-brand-dark/5 text-[10px] text-brand-dark">{t.id}</span>
                </div>
                <a href={orderLink} class="btn-secondary mt-3 !py-1.5 text-xs">
                  Get a CV Like This
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <div class="mt-14 rounded-xl bg-cream p-6 text-center sm:p-8">
      <h2 class="text-lg font-bold text-brand-dark">Not sure which one to pick?</h2>
      <p class="mx-auto mt-2 max-w-xl text-sm text-slate-600">
        Message us on WhatsApp and we'll help you choose the right CV package for the jobs you're applying to.
      </p>
      <a href={genericWaLink} target="_blank" rel="noopener noreferrer" class="btn-primary mt-4">
        Chat With Us on WhatsApp
      </a>
    </div>
  </div>

  <!-- Fullscreen CV preview modal -->
  <div id="cv-modal" hidden class="fixed inset-0 z-[100] flex flex-col bg-black/90">
    <div class="flex shrink-0 items-center justify-between border-b border-white/10 p-4">
      <p id="cv-modal-title" class="text-sm font-semibold text-white sm:text-base"></p>
      <button type="button" id="cv-modal-close" aria-label="Close" class="rounded-full bg-white/10 p-2 text-white hover:bg-white/20">
        ✕
      </button>
    </div>
    <div class="flex-1 overflow-y-auto p-4">
      <div class="mx-auto flex min-h-full max-w-2xl justify-center">
        <img id="cv-modal-image" src="" alt="" class="h-auto w-full object-contain" />
      </div>
    </div>
    <div class="shrink-0 border-t border-white/10 bg-black p-4 text-center">
      <a id="cv-modal-order" href="#" class="btn-primary w-full sm:w-auto">
        Get a CV Like This
      </a>
      <p class="mt-2 text-xs text-white/60">Scroll to view the full CV • Tap ✕ or outside to close</p>
    </div>
  </div>
</Layout>

<script>
  const modal = document.getElementById('cv-modal') as HTMLDivElement;
  const modalImage = document.getElementById('cv-modal-image') as HTMLImageElement;
  const modalTitle = document.getElementById('cv-modal-title') as HTMLParagraphElement;
  const modalOrder = document.getElementById('cv-modal-order') as HTMLAnchorElement;
  const closeBtn = document.getElementById('cv-modal-close') as HTMLButtonElement;

  function openModal(image: string, title: string, waHref: string) {
    modalImage.src = image;
    modalImage.alt = title;
    modalTitle.textContent = title;
    modalOrder.href = waHref;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.hidden = true;
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLButtonElement>('.cv-card-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const { image, title, wa } = btn.dataset;
      if (image && title && wa) openModal(image, title, wa);
    });
  });

  closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });
</script>
