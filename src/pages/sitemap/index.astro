---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { NAV_CATEGORIES, NAV_LOCATIONS } from '../../lib/taxonomy';

const title = 'Sitemap | JobVacancy.co.ke';
const description = 'Every page on JobVacancy.co.ke — jobs by category, jobs by location, and site pages, in one place.';

const mainPages = [
  { name: 'Home', href: '/' },
  { name: 'Browse All Jobs', href: '/jobs/' },
  { name: 'Post a Job', href: '/post-a-job/' },
  { name: 'CV & Resume Services', href: '/cv-builder/' },
  { name: 'CV Designs & Templates', href: '/cv-and-resume-services/' },
  { name: 'FAQ', href: '/faq/' },
  { name: 'About Us', href: '/about/' },
  { name: 'Contact', href: '/contact/' },
];

const legalPages = [
  { name: 'Editorial Policy', href: '/editorial-policy/' },
  { name: 'Disclaimer', href: '/disclaimer/' },
  { name: 'Scam Alert', href: '/scam-alert/' },
  { name: 'Privacy Policy', href: '/privacy-policy/' },
  { name: 'Terms of Use', href: '/terms/' },
];
---

<Layout title={title} description={description} path="/sitemap/">
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Sitemap' }]} />
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <h1 class="text-3xl font-extrabold text-brand-dark">Sitemap</h1>
    <p class="mt-3 text-slate-600">
      Every page on JobVacancy.co.ke, grouped for easy browsing. Looking for the machine-readable version instead?
      See our <a href="/sitemap.xml" class="font-semibold text-brand-orange">XML sitemap</a>.
    </p>

    <div class="mt-8 grid grid-cols-1 gap-10 sm:grid-cols-2">
      <div>
        <h2 class="text-sm font-bold uppercase tracking-wide text-slate-500">Main Pages</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {mainPages.map((p) => (
            <li><a href={p.href} class="font-semibold text-brand-dark hover:text-brand-orange">{p.name}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-bold uppercase tracking-wide text-slate-500">Legal &amp; Trust</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {legalPages.map((p) => (
            <li><a href={p.href} class="font-semibold text-brand-dark hover:text-brand-orange">{p.name}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-bold uppercase tracking-wide text-slate-500">Jobs by Category</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {NAV_CATEGORIES.map((c) => (
            <li><a href={`/category/${c.slug}/`} class="font-semibold text-brand-dark hover:text-brand-orange">{c.name}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-bold uppercase tracking-wide text-slate-500">Jobs by Location</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {NAV_LOCATIONS.map((l) => (
            <li><a href={`/location/${l.slug}/`} class="font-semibold text-brand-dark hover:text-brand-orange">{l.name}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <p class="mt-10 text-sm text-slate-500">
      Individual job listings aren't listed here since they change daily — browse
      <a href="/jobs/" class="font-semibold text-brand-orange">all open jobs</a> instead, or check the
      <a href="/sitemap.xml" class="font-semibold text-brand-orange">XML sitemap</a> for the full, current list of URLs.
    </p>
  </div>
</Layout>
