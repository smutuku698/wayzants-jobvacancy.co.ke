---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JobCard from '../../components/JobCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getApprovedJobs, getCategories, getLocations } from '../../lib/queries';
import { JOB_TYPE_LABELS } from '../../lib/types';

const url = Astro.url;
const search = url.searchParams.get('search') ?? '';
const categorySlug = url.searchParams.get('category') ?? '';
const locationSlug = url.searchParams.get('location') ?? '';
const jobType = url.searchParams.get('type') ?? '';
const remoteOnly = url.searchParams.get('remote') === '1';
const page = Math.max(1, Number(url.searchParams.get('page') ?? '1') || 1);

const [categories, locations, result] = await Promise.all([
  getCategories().catch(() => []),
  getLocations().catch(() => []),
  getApprovedJobs({ search, categorySlug, locationSlug, jobType, remoteOnly, page }).catch(() => ({
    jobs: [],
    total: 0,
    page: 1,
    pageSize: 20,
  })),
]);

const totalPages = Math.max(1, Math.ceil(result.total / result.pageSize));

const title = search
  ? `"${search}" Jobs in Kenya | JobVacancy.co.ke`
  : 'Browse All Jobs in Kenya | JobVacancy.co.ke';
const description =
  'Search and filter the latest jobs in Kenya by category, location and job type. New vacancies added daily.';
---

<Layout title={title} description={description} path="/jobs/">
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'All Jobs' }]} />

  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
    <h1 class="text-2xl font-extrabold text-brand-dark sm:text-3xl">
      {search ? `Search results for "${search}"` : 'Browse All Jobs in Kenya'}
    </h1>
    <p class="mt-1 text-slate-500">{result.total} open role{result.total === 1 ? '' : 's'} found.</p>

    <div class="mt-6 grid grid-cols-1 gap-8 lg:grid-cols-[280px_1fr]">
      <aside>
        <details open class="card p-4">
          <summary class="cursor-pointer text-sm font-bold text-brand-dark lg:hidden">Filters</summary>
          <form method="get" action="/jobs/" class="mt-4 space-y-5 lg:mt-0">
            <div>
              <label for="search" class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500">Keyword</label>
              <input id="search" type="text" name="search" value={search} placeholder="Job title or company" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none focus:border-brand-orange" />
            </div>
            <div>
              <label for="category" class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500">Category</label>
              <select id="category" name="category" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none focus:border-brand-orange">
                <option value="">All Categories</option>
                {categories.map((c) => (
                  <option value={c.slug} selected={c.slug === categorySlug}>{c.name}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="location" class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500">Location</label>
              <select id="location" name="location" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none focus:border-brand-orange">
                <option value="">All Locations</option>
                {locations.map((l) => (
                  <option value={l.slug} selected={l.slug === locationSlug}>{l.name}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="type" class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-slate-500">Job Type</label>
              <select id="type" name="type" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none focus:border-brand-orange">
                <option value="">All Types</option>
                {Object.entries(JOB_TYPE_LABELS).map(([value, label]) => (
                  <option value={value} selected={value === jobType}>{label}</option>
                ))}
              </select>
            </div>
            <label class="flex items-center gap-2 text-sm text-brand-dark">
              <input type="checkbox" name="remote" value="1" checked={remoteOnly} class="h-4 w-4 rounded border-slate-300 text-brand-orange focus:ring-brand-orange" />
              Remote / Online only
            </label>
            <button type="submit" class="btn-primary w-full">Apply Filters</button>
            {(search || categorySlug || locationSlug || jobType || remoteOnly) && (
              <a href="/jobs/" class="block text-center text-sm font-semibold text-slate-500 hover:text-brand-orange">Clear all filters</a>
            )}
          </form>
        </details>
      </aside>

      <div>
        {result.jobs.length > 0 ? (
          <div class="grid grid-cols-1 gap-4">
            {result.jobs.map((job) => <JobCard job={job} />)}
          </div>
        ) : (
          <div class="card p-10 text-center text-slate-500">
            <p class="font-semibold text-brand-dark">No jobs match your filters right now.</p>
            <p class="mt-1 text-sm">Try broadening your search, or check back soon — new jobs are added daily.</p>
            <a href="/jobs/" class="btn-secondary mt-4 inline-flex">Clear filters</a>
          </div>
        )}
        <Pagination page={result.page} totalPages={totalPages} basePath="/jobs/" searchParams={url.searchParams} />
      </div>
    </div>
  </div>
</Layout>
