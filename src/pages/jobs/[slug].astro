---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JobCard from '../../components/JobCard.astro';
import { getJobBySlug, getRelatedJobs } from '../../lib/queries';
import { formatSalary, formatDate, timeAgo } from '../../lib/format';
import { jobPostingJsonLd, breadcrumbJsonLd, jobTypeLabel, SITE_URL } from '../../lib/seo';

const { slug } = Astro.params;
const job = slug ? await getJobBySlug(slug).catch(() => null) : null;

if (!job) {
  return Astro.rewrite('/404');
}

const relatedJobs = await getRelatedJobs(job).catch(() => []);
const salary = formatSalary(job);

const breadcrumbItems = [
  { name: 'Home', href: '/' },
  { name: job.job_categories?.name ?? 'Jobs', href: `/category/${job.job_categories?.slug}/` },
  { name: job.title },
];

const title = `${job.title} at ${job.company_name} — ${job.is_remote ? 'Remote' : job.locations?.name} | JobVacancy.co.ke`;
const description = `${job.title} at ${job.company_name}. ${job.description.slice(0, 130).replace(/\s+/g, ' ')}...`;

const jsonLd = [
  jobPostingJsonLd(job),
  breadcrumbJsonLd(
    breadcrumbItems.map((b) => ({ name: b.name, url: b.href ? new URL(b.href, SITE_URL).toString() : Astro.url.toString() }))
  ),
];

const applyHref = job.application_method === 'email' ? `mailto:${job.application_value}?subject=${encodeURIComponent(`Application: ${job.title}`)}` : job.application_value;
---

<Layout title={title} description={description} path={`/jobs/${job.slug}/`} jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />

  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6">
    <div class="card p-6 sm:p-8">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="flex items-start gap-4">
          <div class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-cream ring-1 ring-slate-200">
            {job.company_logo_url ? (
              <img src={job.company_logo_url} alt={`${job.company_name} logo`} width="56" height="56" class="h-full w-full object-cover" />
            ) : (
              <span class="text-xl font-bold text-brand-dark/40">{job.company_name.charAt(0)}</span>
            )}
          </div>
          <div>
            <h1 class="text-xl font-extrabold text-brand-dark sm:text-2xl">{job.title}</h1>
            <p class="mt-1 font-medium text-slate-600">{job.company_name}</p>
          </div>
        </div>
        {job.is_international && <span class="badge shrink-0 bg-brand-orange/10 text-brand-orange">International</span>}
      </div>

      <div class="mt-5 flex flex-wrap gap-2 text-xs">
        <span class="badge bg-brand-dark/5 text-brand-dark">{jobTypeLabel(job.job_type)}</span>
        <span class="badge bg-brand-dark/5 text-brand-dark">{job.is_remote ? 'Remote / Online' : job.locations?.name}</span>
        {salary && <span class="badge bg-brand-green/10 text-brand-green-dark">{salary}</span>}
        <span class="badge bg-slate-100 text-slate-500">Posted {timeAgo(job.created_at)}</span>
      </div>

      <div class="mt-6 flex flex-col gap-3 border-y border-slate-100 py-5 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-slate-500">
          {job.deadline ? <>Application deadline: <b class="text-brand-dark">{formatDate(job.deadline)}</b></> : 'Apply as soon as possible'}
        </p>
        <a href={applyHref} rel="nofollow noopener" target={job.application_method === 'url' ? '_blank' : undefined} class="btn-primary">
          Apply Now
        </a>
      </div>

      <div class="prose prose-slate mt-6 max-w-none whitespace-pre-line text-slate-700">
        {job.description}
      </div>

      <div class="mt-8 border-t border-slate-100 pt-6 text-center">
        <a href={applyHref} rel="nofollow noopener" target={job.application_method === 'url' ? '_blank' : undefined} class="btn-primary">
          Apply Now
        </a>
        {job.is_international && (
          <p class="mt-3 text-xs text-slate-400">This is a 100% remote/virtual role — no relocation required.</p>
        )}
      </div>
    </div>

    {relatedJobs.length > 0 && (
      <div class="mt-10">
        <h2 class="text-xl font-bold text-brand-dark">More {job.job_categories?.name}</h2>
        <div class="mt-4 grid grid-cols-1 gap-4">
          {relatedJobs.map((j) => <JobCard job={j} />)}
        </div>
      </div>
    )}
  </div>
</Layout>
