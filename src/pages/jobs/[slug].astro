---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JobCard from '../../components/JobCard.astro';
import { getJobBySlug, getRelatedJobs } from '../../lib/queries';
import { formatSalary, formatDate, timeAgo, formatJobDescription } from '../../lib/format';
import { jobPostingJsonLd, breadcrumbJsonLd, jobTypeLabel, SITE_URL } from '../../lib/seo';
import { RELATED_CATEGORIES, NAV_CATEGORIES } from '../../lib/taxonomy';

const { slug } = Astro.params;
const job = slug ? await getJobBySlug(slug).catch(() => null) : null;

if (!job) {
  return Astro.rewrite('/404');
}

const relatedJobs = await getRelatedJobs(job).catch(() => []);
const salary = formatSalary(job);

const breadcrumbItems = [
  { name: 'Home', href: '/' },
  { name: job.job_categories?.name ?? 'Jobs', href: `/category/${job.job_categories?.slug}/` },
  { name: job.title },
];

const title = `${job.title} at ${job.company_name} — ${job.is_remote ? 'Remote' : job.locations?.name} | JobVacancy.co.ke`;
const description =
  job.ai_enhancement?.metaDescription ||
  `${job.title} at ${job.company_name}. ${job.description.slice(0, 130).replace(/\s+/g, ' ')}...`;

const jsonLd = [
  jobPostingJsonLd(job),
  breadcrumbJsonLd(
    breadcrumbItems.map((b) => ({ name: b.name, url: b.href ? new URL(b.href, SITE_URL).toString() : Astro.url.toString() }))
  ),
];

const applyHref = job.application_method === 'email' ? `mailto:${job.application_value}?subject=${encodeURIComponent(`Application: ${job.title}`)}` : job.application_value;

// Vertical interlinking (site-wide, for SEO) — only for categories with a
// genuine relation defined in taxonomy.ts; an irrelevant "related category"
// link does more harm than good.
const relatedCategorySlugs = job.job_categories ? RELATED_CATEGORIES[job.job_categories.slug] ?? [] : [];
const relatedCategoryLinks = relatedCategorySlugs
  .map((s) => NAV_CATEGORIES.find((c) => c.slug === s))
  .filter((c): c is NonNullable<typeof c> => c !== undefined);
---

<Layout title={title} description={description} path={`/jobs/${job.slug}/`} jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />

  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6">
    <div class="card p-6 sm:p-8">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="flex items-start gap-4">
          <div class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-cream ring-1 ring-slate-200">
            {job.company_logo_url ? (
              <img src={job.company_logo_url} alt={`${job.company_name} logo`} width="56" height="56" class="h-full w-full object-cover" />
            ) : (
              <span class="text-xl font-bold text-brand-dark/40">{job.company_name.charAt(0)}</span>
            )}
          </div>
          <div>
            <h1 class="text-xl font-extrabold text-brand-dark sm:text-2xl">{job.title}</h1>
            <p class="mt-1 font-medium text-slate-600">{job.company_name}</p>
          </div>
        </div>
        {job.is_international && <span class="badge shrink-0 bg-brand-orange/10 text-brand-orange">International</span>}
      </div>

      <div class="mt-5 flex flex-wrap gap-2 text-xs">
        <span class="badge bg-brand-dark/5 text-brand-dark">{jobTypeLabel(job.job_type)}</span>
        <span class="badge bg-brand-dark/5 text-brand-dark">{job.is_remote ? 'Remote / Online' : job.locations?.name}</span>
        {salary && <span class="badge bg-brand-green/10 text-brand-green-dark">{salary}</span>}
        <span class="badge bg-slate-100 text-slate-500">Posted {timeAgo(job.created_at)}</span>
      </div>

      <div class="mt-6 flex flex-col gap-3 border-y border-slate-100 py-5 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm text-slate-500">
          {job.deadline ? <>Application deadline: <b class="text-brand-dark">{formatDate(job.deadline)}</b></> : 'Apply as soon as possible'}
        </p>
        <a href={applyHref} rel="nofollow noopener" target={job.application_method === 'url' ? '_blank' : undefined} class="btn-primary">
          Apply Now
        </a>
      </div>

      <div class="mt-6 max-w-none text-slate-700">
        {formatJobDescription(job.description).map((block) =>
          block.type === 'h2' ? (
            <h2 class="mt-6 text-lg font-bold text-brand-dark first:mt-0">{block.text}</h2>
          ) : block.type === 'h3' ? (
            <h3 class="mt-4 text-base font-bold text-brand-dark">{block.text}</h3>
          ) : (
            <p class="mt-3 leading-relaxed first:mt-0">{block.text}</p>
          )
        )}
      </div>

      {job.ai_enhancement && (
        <div class="mt-8 border-t border-slate-100 pt-6">
          {job.ai_enhancement.jobSummary && (
            <p class="leading-relaxed text-slate-700">{job.ai_enhancement.jobSummary}</p>
          )}

          {job.ai_enhancement.skills.length > 0 && (
            <div class="mt-6">
              <h2 class="text-base font-bold text-brand-dark">Key Skills</h2>
              <div class="mt-3 flex flex-wrap gap-2">
                {job.ai_enhancement.skills.map((skill) => (
                  <span class="badge bg-brand-dark/5 text-brand-dark">{skill}</span>
                ))}
              </div>
            </div>
          )}

          {job.ai_enhancement.kenyaSalaryEstimate && (
            <div class="mt-6">
              <h2 class="text-base font-bold text-brand-dark">Kenya Salary Estimate</h2>
              <p class="mt-2 text-sm text-slate-600">{job.ai_enhancement.kenyaSalaryEstimate}</p>
            </div>
          )}

          {job.ai_enhancement.companyInsights && (
            <div class="mt-6">
              <h2 class="text-base font-bold text-brand-dark">Company Insights</h2>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{job.ai_enhancement.companyInsights}</p>
            </div>
          )}

          {job.ai_enhancement.workEnvironment && (
            <div class="mt-6">
              <h2 class="text-base font-bold text-brand-dark">Work Environment &amp; Culture</h2>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{job.ai_enhancement.workEnvironment}</p>
            </div>
          )}

          {job.ai_enhancement.careerGrowth && (
            <div class="mt-6">
              <h2 class="text-base font-bold text-brand-dark">Career Growth &amp; Development</h2>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{job.ai_enhancement.careerGrowth}</p>
            </div>
          )}

          {job.ai_enhancement.benefits && (
            <div class="mt-6">
              <h2 class="text-base font-bold text-brand-dark">Benefits &amp; Compensation</h2>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{job.ai_enhancement.benefits}</p>
            </div>
          )}

          {job.ai_enhancement.marketContext && (
            <div class="mt-6">
              <h2 class="text-base font-bold text-brand-dark">Market Context &amp; Industry Insights</h2>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{job.ai_enhancement.marketContext}</p>
            </div>
          )}

          {job.ai_enhancement.applicationTips.length > 0 && (
            <div class="mt-6">
              <h2 class="text-base font-bold text-brand-dark">Application Tips</h2>
              <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-slate-600">
                {job.ai_enhancement.applicationTips.map((tip) => (
                  <li>{tip}</li>
                ))}
              </ul>
            </div>
          )}

          {job.ai_enhancement.kenyaContext && (
            <div class="mt-6 rounded-lg bg-cream p-4 text-sm text-brand-dark/80">
              {job.ai_enhancement.kenyaContext}
            </div>
          )}
        </div>
      )}

      <div class="mt-8 border-t border-slate-100 pt-6 text-center">
        <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href={applyHref} rel="nofollow noopener" target={job.application_method === 'url' ? '_blank' : undefined} class="btn-primary">
            Apply Now
          </a>
          <a href="/cv-and-resume-services/" class="btn-secondary">
            Get Best CV/Resume for All Jobs Now!
          </a>
        </div>
        {job.is_international && (
          <p class="mt-3 text-xs text-slate-400">This is a 100% remote/virtual role — no relocation required.</p>
        )}
      </div>
    </div>

    {relatedCategoryLinks.length > 0 && (
      <div class="mt-10 flex flex-wrap items-center justify-center gap-2 text-sm">
        <span class="text-slate-500">Explore related categories:</span>
        {relatedCategoryLinks.map((c) => (
          <a href={`/category/${c.slug}/`} class="rounded-full border border-border bg-white px-3 py-1.5 font-semibold text-brand-dark hover:border-brand-orange hover:text-brand-orange">
            {c.name}
          </a>
        ))}
      </div>
    )}

    {relatedJobs.length > 0 && (
      <div class="mt-10">
        <h2 class="text-xl font-bold text-brand-dark">More {job.job_categories?.name}</h2>
        <div class="mt-4 grid grid-cols-1 gap-4">
          {relatedJobs.map((j) => <JobCard job={j} />)}
        </div>
      </div>
    )}
  </div>
</Layout>
