---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Job Submitted — Thank You | JobVacancy.co.ke"
  description="Your job listing has been submitted for review."
  path="/post-a-job/thank-you/"
  noindex
>
  <div class="mx-auto max-w-xl px-4 py-20 text-center sm:px-6">
    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand-green/10 text-brand-green">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none"><path d="m5 13 4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </div>
    <h1 class="mt-6 text-2xl font-extrabold text-brand-dark sm:text-3xl">Thanks — your job is in review!</h1>
    <p class="mt-3 text-slate-600">
      Our team reviews every submission before it goes live, usually within 24 hours. We'll publish it as soon as
      it's approved.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/jobs/" class="btn-secondary">Browse Jobs</a>
      <a href="/" class="btn-primary">Back to Home</a>
    </div>
  </div>
</Layout>
