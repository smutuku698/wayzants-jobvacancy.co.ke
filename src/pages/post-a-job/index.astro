---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCategories, getLocations } from '../../lib/queries';
import { JOB_TYPE_LABELS } from '../../lib/types';

const [categories, locations] = await Promise.all([
  getCategories().catch(() => []),
  getLocations().catch(() => []),
]);

const error = Astro.url.searchParams.get('error');
const reason = Astro.url.searchParams.get('reason');
const ERROR_MESSAGES: Record<string, string> = {
  missing_fields: 'Please fill in all required fields and try again.',
  invalid_logo: 'Your logo must be a genuine JPG, PNG or WEBP image under 2MB.',
  invalid_fields:
    'Please check your email address and application link/email, and make sure no field is unusually long, then try again.',
  invalid_phone: 'Please enter a valid Safaricom/Airtel M-Pesa number (e.g. 07XX XXX XXX).',
  payment_failed: "We couldn't start the M-Pesa payment with that number. Please check it and try again.",
  server_error: 'Something went wrong on our end. Please try again in a moment.',
};

const CURRENCIES = ['KES', 'USD', 'GBP', 'EUR'];

const title = 'Post a Job in Kenya — Free Job Listing | JobVacancy.co.ke';
const description =
  'Post a job in Kenya for free. Reach job seekers across Nairobi, Mombasa, Kisumu and beyond. Every listing is reviewed before it goes live.';
---

<Layout title={title} description={description} path="/post-a-job/">
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Post a Job' }]} />

  <div class="mx-auto max-w-3xl px-4 py-8 sm:px-6">
    <h1 class="text-2xl font-extrabold text-brand-dark sm:text-3xl">Post a Job — 100% Free</h1>
    <p class="mt-2 text-slate-600">
      Reach thousands of job seekers across Kenya. Every submission is checked by our team before it goes live,
      usually within 24 hours — genuine roles get published, and listings that look like scams or charge
      applicants a fee are rejected.
    </p>
    <p class="mt-1 text-sm text-slate-500">Fields marked * are required. The examples in each field are just a guide — replace them with your own details.</p>

    {error && (
      <div class="mt-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        {ERROR_MESSAGES[error] ?? ERROR_MESSAGES.server_error}
        {error === 'payment_failed' && reason && (
          <span class="mt-1 block text-xs text-red-500">Details: {reason}</span>
        )}
      </div>
    )}

    <form method="post" action="/api/jobs/submit/" enctype="multipart/form-data" class="card mt-6 space-y-6 p-6 sm:p-8">
      <fieldset class="space-y-4">
        <legend class="text-sm font-bold uppercase tracking-wide text-slate-500">Job Details</legend>
        <div>
          <label for="title" class="mb-1.5 block text-sm font-semibold text-brand-dark">Job Title *</label>
          <input id="title" name="title" type="text" required maxlength="120" placeholder="e.g. Accountant, Sales Executive, Programme Officer – M&E" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-brand-orange" />
          <p class="mt-1 text-xs text-slate-400">Use the actual job title only — no "URGENT!!!", salary figures or contact details here.</p>
        </div>
        <div>
          <label for="company_name" class="mb-1.5 block text-sm font-semibold text-brand-dark">Company / Organisation Name *</label>
          <input id="company_name" name="company_name" type="text" required maxlength="150" placeholder="e.g. Kenya Red Cross Society" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-brand-orange" />
          <p class="mt-1 text-xs text-slate-400">The real, verifiable name of the hiring company — not a recruiter's personal name.</p>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="category_id" class="mb-1.5 block text-sm font-semibold text-brand-dark">Category *</label>
            <select id="category_id" name="category_id" required class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-brand-orange">
              <option value="">Select a category</option>
              {categories.map((c) => <option value={c.id}>{c.name}</option>)}
            </select>
          </div>
          <div>
            <label for="job_type" class="mb-1.5 block text-sm font-semibold text-brand-dark">Job Type *</label>
            <select id="job_type" name="job_type" required class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-brand-orange">
              {Object.entries(JOB_TYPE_LABELS).map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </div>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="location_id" class="mb-1.5 block text-sm font-semibold text-brand-dark">Location *</label>
            <select id="location_id" name="location_id" required class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-brand-orange">
              <option value="">Select a location</option>
              {locations.map((l) => <option value={l.id}>{l.name}</option>)}
            </select>
          </div>
          <div class="flex flex-col justify-end gap-2 pb-1">
            <label class="flex items-center gap-2 text-sm text-brand-dark">
              <input type="checkbox" name="is_remote" value="1" class="h-4 w-4 rounded border-slate-300 text-brand-orange focus:ring-brand-orange" />
              This role is remote / online
            </label>
            <label class="flex items-center gap-2 text-sm text-brand-dark">
              <input type="checkbox" name="is_international" value="1" class="h-4 w-4 rounded border-slate-300 text-brand-orange focus:ring-brand-orange" />
              International (100% virtual) role
            </label>
          </div>
        </div>
        <div>
          <label for="description" class="mb-1.5 block text-sm font-semibold text-brand-dark">Job Description *</label>
          <textarea
            id="description"
            name="description"
            required
            minlength="30"
            rows="10"
            placeholder={`e.g.\n\nAbout the role:\nWe are looking for a Sales Executive to grow our client base in Nairobi.\n\nKey responsibilities:\n- Identify and approach new business leads\n- Meet monthly sales targets\n- Prepare weekly sales reports\n\nRequirements:\n- Diploma or degree in Sales/Marketing or related field\n- 2+ years' experience in a similar role\n- Excellent communication skills\n\nHow to apply:\nSend your CV and cover letter to the email/link below by [deadline].`}
            class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-brand-orange"></textarea>
          <p class="mt-1 text-xs text-slate-400">
            A few honest lines about the role and how to apply is enough — you don't need a big company or a long
            write-up. More detail (responsibilities, requirements, qualifications) does help you get more
            applicants though. Do not mention application fees, forex/crypto "training", or requests for
            ID/M-Pesa details — those get rejected.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
          <div>
            <label for="salary_min" class="mb-1.5 block text-sm font-semibold text-brand-dark">Min Salary</label>
            <input id="salary_min" name="salary_min" type="number" min="0" step="1" placeholder="e.g. 45000" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-brand-orange" />
          </div>
          <div>
            <label for="salary_max" class="mb-1.5 block text-sm font-semibold text-brand-dark">Max Salary</label>
            <input id="salary_max" name="salary_max" type="number" min="0" step="1" placeholder="e.g. 80000" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-brand-orange" />
          </div>
          <div>
            <label for="salary_currency" class="mb-1.5 block text-sm font-semibold text-brand-dark">Currency</label>
            <select id="salary_currency" name="salary_currency" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-brand-orange">
              {CURRENCIES.map((c) => <option value={c}>{c}</option>)}
            </select>
          </div>
          <div>
            <label for="deadline" class="mb-1.5 block text-sm font-semibold text-brand-dark">Application Deadline</label>
            <input id="deadline" name="deadline" type="date" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-brand-orange" />
          </div>
        </div>
        <p class="-mt-2 text-xs text-slate-400">
          Salary is optional but listings with a salary range get significantly more applicants. Use whole numbers
          only (e.g. 45000, not "45,000" or "45k"). Pick USD/GBP/EUR for roles paid in foreign currency (e.g.
          international remote or teaching-abroad jobs).
        </p>
        <div>
          <label for="logo" class="mb-1.5 block text-sm font-semibold text-brand-dark">Company Logo</label>
          <input id="logo" name="logo" type="file" accept="image/png,image/jpeg,image/webp" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm outline-none file:mr-3 file:rounded-md file:border-0 file:bg-cream file:px-3 file:py-1.5 file:text-sm focus:border-brand-orange" />
          <p class="mt-1 text-xs text-slate-400">JPG, PNG or WEBP, up to 2MB. Optional.</p>
        </div>
      </fieldset>

      <fieldset class="space-y-4 border-t border-slate-100 pt-6">
        <legend class="text-sm font-bold uppercase tracking-wide text-slate-500">How to Apply</legend>
        <div class="flex gap-6 text-sm">
          <label class="flex items-center gap-2 text-brand-dark">
            <input type="radio" name="application_method" value="email" checked required class="h-4 w-4 text-brand-orange focus:ring-brand-orange" />
            Email
          </label>
          <label class="flex items-center gap-2 text-brand-dark">
            <input type="radio" name="application_method" value="url" required class="h-4 w-4 text-brand-orange focus:ring-brand-orange" />
            Application link
          </label>
        </div>
        <div>
          <label for="application_value" class="mb-1.5 block text-sm font-semibold text-brand-dark">Application Email or URL *</label>
          <input id="application_value" name="application_value" type="text" required placeholder="e.g. jobs@company.com or https://company.com/careers/apply" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-brand-orange" />
          <p class="mt-1 text-xs text-slate-400">A work email at your company's domain or a real application link — not a personal Gmail/WhatsApp number.</p>
        </div>
      </fieldset>

      <fieldset class="space-y-4 border-t border-slate-100 pt-6">
        <legend class="text-sm font-bold uppercase tracking-wide text-slate-500">Your Contact Details</legend>
        <p class="text-xs text-slate-400">Not published — used only if we need to verify this listing.</p>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label for="contact_name" class="mb-1.5 block text-sm font-semibold text-brand-dark">Your Name</label>
            <input id="contact_name" name="contact_name" type="text" placeholder="e.g. Jane Wanjiku" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-brand-orange" />
          </div>
          <div>
            <label for="contact_email" class="mb-1.5 block text-sm font-semibold text-brand-dark">Your Email *</label>
            <input id="contact_email" name="contact_email" type="email" required placeholder="e.g. hr@company.com" class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-brand-orange" />
          </div>
        </div>
      </fieldset>

      <fieldset class="space-y-3 border-t border-slate-100 pt-6">
        <legend class="text-sm font-bold uppercase tracking-wide text-slate-500">Before You Submit</legend>
        <label class="flex items-start gap-2.5 text-sm text-brand-dark">
          <input type="checkbox" name="confirm_genuine" value="1" required class="mt-0.5 h-4 w-4 rounded border-slate-300 text-brand-orange focus:ring-brand-orange" />
          <span>
            I confirm this is a genuine job opening and that applicants will never be asked to pay any fee, buy
            starter kits, or share M-Pesa/ID details to apply or get hired. *
          </span>
        </label>
      </fieldset>

      <input type="hidden" name="pricing_tier" id="pricing_tier" />
      <input type="hidden" name="mpesa_phone" id="mpesa_phone" />

      <button type="submit" id="submit-job-btn" class="btn-primary w-full !py-3 text-base">Continue to Payment</button>
    </form>
  </div>

  <!-- Tier picker modal — shown after the form's own required-field validation
       passes, before the real submission (which now requires payment) fires. -->
  <div id="tier-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-brand-dark/60 p-4" hidden>
    <div class="max-h-[90vh] w-full max-w-md overflow-y-auto rounded-xl bg-white p-6 shadow-lg sm:p-8">
      <h2 class="text-xl font-extrabold text-brand-dark">Choose Your Listing</h2>
      <p class="mt-2 text-sm italic text-slate-500">
        Due to a rise in scam job postings, we've introduced a small, one-time listing fee to keep this board
        genuine — thank you for your understanding.
      </p>

      <div class="mt-5 space-y-3">
        <label class="tier-option card flex cursor-pointer items-start gap-3 p-4">
          <input type="radio" name="tier_choice" value="5day" checked class="mt-1 h-4 w-4 text-brand-orange focus:ring-brand-orange" />
          <span>
            <span class="block font-bold text-brand-dark">KES 100 — 60-day listing</span>
            <span class="block text-sm text-slate-500">Featured on the homepage for 5 days, then listed for the rest of the 60 days.</span>
          </span>
        </label>
        <label class="tier-option card flex cursor-pointer items-start gap-3 p-4">
          <input type="radio" name="tier_choice" value="14day" class="mt-1 h-4 w-4 text-brand-orange focus:ring-brand-orange" />
          <span>
            <span class="block font-bold text-brand-dark">KES 200 — 60-day listing</span>
            <span class="block text-sm text-slate-500">Featured on the homepage for 14 days, then listed for the rest of the 60 days.</span>
          </span>
        </label>
      </div>

      <div class="mt-5">
        <label for="modal_phone" class="mb-1.5 block text-sm font-semibold text-brand-dark">M-Pesa Phone Number *</label>
        <input
          id="modal_phone"
          type="tel"
          inputmode="tel"
          placeholder="e.g. 0722 123 456"
          class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-brand-orange"
        />
        <p id="modal_phone_error" class="mt-1 hidden text-xs text-red-600">Enter a valid Safaricom/Airtel number.</p>
      </div>

      <div class="mt-6 flex gap-3">
        <button type="button" id="tier-modal-cancel" class="btn-secondary flex-1">Cancel</button>
        <button type="button" id="tier-modal-pay" class="btn-primary flex-1">Pay with M-Pesa</button>
      </div>
    </div>
  </div>

  <script>
    const form = document.querySelector('form[action="/api/jobs/submit/"]') as HTMLFormElement;
    const modal = document.getElementById('tier-modal') as HTMLElement;
    const tierInput = document.getElementById('pricing_tier') as HTMLInputElement;
    const phoneInput = document.getElementById('mpesa_phone') as HTMLInputElement;
    const modalPhone = document.getElementById('modal_phone') as HTMLInputElement;
    const modalPhoneError = document.getElementById('modal_phone_error') as HTMLElement;

    const KE_PHONE_RE = /^(?:\+?254|0)([17]\d{8})$/;

    function openModal() {
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
    }
    function closeModal() {
      modal.hidden = true;
      document.body.style.overflow = '';
    }

    form.addEventListener('submit', (event) => {
      // Already populated by the modal's "Pay with M-Pesa" step — let it through.
      if (tierInput.value && phoneInput.value) return;
      event.preventDefault();
      openModal();
    });

    document.getElementById('tier-modal-cancel')?.addEventListener('click', closeModal);

    document.getElementById('tier-modal-pay')?.addEventListener('click', () => {
      const digits = modalPhone.value.replace(/[^\d+]/g, '');
      if (!KE_PHONE_RE.test(digits)) {
        modalPhoneError.classList.remove('hidden');
        return;
      }
      modalPhoneError.classList.add('hidden');
      const tier = (document.querySelector('input[name="tier_choice"]:checked') as HTMLInputElement).value;
      tierInput.value = tier;
      phoneInput.value = digits;
      closeModal();
      form.requestSubmit();
    });
  </script>
</Layout>
