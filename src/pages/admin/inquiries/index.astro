---
import Layout from '../../../layouts/Layout.astro';
import { getInquiries } from '../../../lib/queries';
import { timeAgo } from '../../../lib/format';
import { INQUIRY_TYPE_LABELS } from '../../../lib/types';
import type { InquiryStatus } from '../../../lib/types';

export const prerender = false;

const requestedTab = Astro.url.searchParams.get('tab');
const tab: InquiryStatus = requestedTab === 'read' || requestedTab === 'archived' ? requestedTab : 'new';

const [newCount, inquiries] = await Promise.all([
  getInquiries('new').then((rows) => rows.length).catch(() => 0),
  getInquiries(tab).catch(() => []),
]);

const TABS: { value: InquiryStatus; label: string }[] = [
  { value: 'new', label: `New${newCount ? ` (${newCount})` : ''}` },
  { value: 'read', label: 'Read' },
  { value: 'archived', label: 'Archived' },
];

const TYPE_COLORS: Record<string, string> = {
  comment: 'bg-slate-100 text-slate-600',
  partnership: 'bg-brand-green/15 text-brand-green-dark',
  sponsorship: 'bg-brand-yellow/30 text-brand-dark',
  advertising: 'bg-brand-orange/10 text-brand-orange',
};
---

<Layout title="Admin — Inquiries | JobVacancy.co.ke" description="Work With Us inquiries." path="/admin/inquiries/" noindex>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h1 class="text-2xl font-extrabold text-brand-dark">Work With Us Inquiries</h1>
      <a href="/admin/" class="text-sm font-semibold text-brand-orange hover:underline">&larr; Pending Jobs</a>
    </div>
    <p class="mt-1 text-slate-500">Comments, partnership, sponsorship &amp; advertising inquiries from the footer widget.</p>

    <div class="mt-6 flex gap-2 border-b border-slate-200">
      {TABS.map((t) => (
        <a
          href={`/admin/inquiries/?tab=${t.value}`}
          class={`-mb-px border-b-2 px-3 py-2 text-sm font-semibold ${
            tab === t.value ? 'border-brand-orange text-brand-orange' : 'border-transparent text-slate-500 hover:text-brand-dark'
          }`}
        >
          {t.label}
        </a>
      ))}
    </div>

    {inquiries.length === 0 ? (
      <div class="card mt-6 p-10 text-center text-slate-500">Nothing here.</div>
    ) : (
      <div class="mt-6 space-y-4">
        {inquiries.map((inquiry) => (
          <div class="card p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <span class={`badge ${TYPE_COLORS[inquiry.type] ?? 'bg-slate-100 text-slate-600'}`}>
                    {INQUIRY_TYPE_LABELS[inquiry.type]}
                  </span>
                  <h2 class="text-base font-bold text-brand-dark">{inquiry.name}</h2>
                  {inquiry.company && <span class="text-sm text-slate-500">&middot; {inquiry.company}</span>}
                </div>
                <p class="mt-1 text-xs text-slate-400">
                  <a href={`mailto:${inquiry.email}`} class="font-semibold text-brand-orange hover:underline">{inquiry.email}</a>
                  &middot; {timeAgo(inquiry.created_at)}
                </p>
              </div>
              <div class="flex shrink-0 gap-2">
                {tab === 'new' && (
                  <form method="post" action={`/api/admin/inquiries/${inquiry.id}/read/`}>
                    <button type="submit" class="btn-primary !py-2 !px-4 text-sm">Mark Read</button>
                  </form>
                )}
                {tab !== 'archived' && (
                  <form method="post" action={`/api/admin/inquiries/${inquiry.id}/archive/`}>
                    <button type="submit" class="rounded-lg border border-slate-200 bg-slate-50 px-4 py-2 text-sm font-semibold text-slate-500 hover:bg-slate-100">Archive</button>
                  </form>
                )}
              </div>
            </div>
            <p class="mt-3 whitespace-pre-line text-sm text-slate-600">{inquiry.message}</p>
          </div>
        ))}
      </div>
    )}
  </div>
</Layout>
