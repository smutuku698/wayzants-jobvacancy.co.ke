---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import { WHATSAPP_NUMBER } from '../../../lib/cv-templates';

const reference = Astro.url.searchParams.get('ref') ?? '';
const supportWaLink = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hi! I have a question about my CV order from JobVacancy.co.ke.')}`;
---

<Layout
  title="Confirm Payment — JobVacancy.co.ke"
  description="Confirm your M-Pesa payment to submit your CV order."
  path="/cv-builder/pay/"
  noindex
>
  <div class="mx-auto max-w-xl px-4 py-20 text-center sm:px-6">
    <div id="state-pending">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand-orange/10 text-brand-orange">
        <svg class="animate-spin" width="32" height="32" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5" stroke-opacity="0.25"></circle>
          <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
        </svg>
      </div>
      <h1 class="mt-6 text-2xl font-extrabold text-brand-dark sm:text-3xl">Check your phone</h1>
      <p class="mt-3 text-slate-600">
        Enter your M-Pesa PIN on the prompt sent to your phone to complete the payment. This page will update
        automatically once it's confirmed — usually within a minute.
      </p>
    </div>

    <div id="state-paid" class="hidden">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand-green/10 text-brand-green">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none"><path d="m5 13 4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </div>
      <h1 class="mt-6 text-2xl font-extrabold text-brand-dark sm:text-3xl">Thank you for your order!</h1>
      <p class="mt-3 text-slate-600">
        A real writer will prepare your ATS-optimized CV. Check your email and WhatsApp within 24 hours for your
        copies.
      </p>
      <p class="mt-2 text-sm text-slate-500">
        Have a question or something to add? Message us on WhatsApp — we've got your number on file.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={supportWaLink} target="_blank" rel="noopener noreferrer" class="btn-primary">Message Us on WhatsApp</a>
        <a href="/" class="btn-secondary">Back to Home</a>
      </div>
    </div>

    <div id="state-checking" class="hidden">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand-orange/10 text-brand-orange">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none"><path d="M12 8v4l2.5 2.5M21 12a9 9 0 1 1-9-9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </div>
      <h1 class="mt-6 text-2xl font-extrabold text-brand-dark sm:text-3xl">Still confirming your payment</h1>
      <p class="mt-3 text-slate-600">
        This is taking longer than usual. If you already completed the M-Pesa prompt on your phone, don't worry —
        your order is still being confirmed. You can safely close this page and check back later, or tap below to
        check again now.
      </p>
      <p class="mt-2 text-sm text-slate-500">
        Still nothing after 10 minutes? Email us at <a href="mailto:hr@jobvacancy.co.ke" class="font-semibold text-brand-orange">hr@jobvacancy.co.ke</a>.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <button type="button" id="recheck-btn" class="btn-primary">Check Again</button>
        <a href="/" class="btn-secondary">Back to Home</a>
      </div>
    </div>

    <div id="state-failed" class="hidden">
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-red-100 text-red-600">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path></svg>
      </div>
      <h1 class="mt-6 text-2xl font-extrabold text-brand-dark sm:text-3xl">Payment didn't go through</h1>
      <p class="mt-3 text-slate-600">
        The M-Pesa payment wasn't completed or was declined. No order has been submitted — please try again.
      </p>
      <div class="mt-8">
        <a href="/cv-builder/" class="btn-primary">Start Over</a>
      </div>
    </div>
  </div>

  <script define:vars={{ reference }}>
    const POLL_INTERVAL_MS = 3000;
    const MAX_ATTEMPTS = 40;

    const states = {
      pending: document.getElementById('state-pending'),
      paid: document.getElementById('state-paid'),
      checking: document.getElementById('state-checking'),
      failed: document.getElementById('state-failed'),
    };

    function show(name) {
      for (const el of Object.values(states)) el.hidden = true;
      states[name].hidden = false;
    }

    async function checkOnce() {
      const res = await fetch(`/api/cv-orders/status/?ref=${encodeURIComponent(reference)}`);
      const body = await res.json();
      return body.status;
    }

    async function pollLoop() {
      let attempts = 0;
      const poll = async () => {
        attempts += 1;
        try {
          const status = await checkOnce();
          if (status === 'paid') return show('paid');
          if (status === 'failed') return show('failed');
        } catch {
          // Transient network hiccup — keep polling until MAX_ATTEMPTS.
        }
        if (attempts >= MAX_ATTEMPTS) return show('checking');
        setTimeout(poll, POLL_INTERVAL_MS);
      };
      poll();
    }

    if (!reference) {
      show('failed');
    } else {
      pollLoop();
      document.getElementById('recheck-btn')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget;
        btn.disabled = true;
        btn.textContent = 'Checking…';
        try {
          const status = await checkOnce();
          if (status === 'paid') return show('paid');
          if (status === 'failed') return show('failed');
        } catch {
          // ignore, re-enable button below
        }
        btn.disabled = false;
        btn.textContent = 'Check Again';
      });
    }
  </script>
</Layout>
