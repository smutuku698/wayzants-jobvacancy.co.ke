---
import Layout from '../layouts/Layout.astro';

Astro.response.status = 404;
---

<Layout title="Page Not Found | JobVacancy.co.ke" description="This page could not be found." path="/404/" noindex>
  <div class="mx-auto max-w-xl px-4 py-24 text-center sm:px-6">
    <p class="text-sm font-bold uppercase tracking-wide text-brand-orange">404</p>
    <h1 class="mt-2 text-3xl font-extrabold text-brand-dark sm:text-4xl">This job listing has moved on.</h1>
    <p class="mt-3 text-slate-600">
      The page you're looking for doesn't exist or the listing may have expired. Let's get you back on track.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/jobs/" class="btn-secondary">Browse All Jobs</a>
      <a href="/" class="btn-primary">Back to Home</a>
    </div>
  </div>
</Layout>
