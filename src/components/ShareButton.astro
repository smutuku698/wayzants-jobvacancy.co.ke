---
interface Props {
  variant?: 'floating' | 'inline';
  label?: string;
}

const { variant = 'floating', label = 'Share' } = Astro.props;

// The popover overlay + its script must exist exactly once per page even
// though this component can appear multiple times (floating sitewide via
// Layout, plus inline on job pages) — only the "floating" instance renders
// the shared singleton; inline instances are just another `.share-trigger`
// button that the singleton's event delegation picks up.
const renderSingleton = variant === 'floating';
---

{variant === 'floating' ? (
  <button
    type="button"
    class="share-trigger fixed bottom-[76px] right-4 z-50 flex h-11 w-11 items-center justify-center rounded-full bg-brand-green text-brand-dark shadow-lg transition hover:opacity-90 sm:bottom-[84px] sm:right-6"
    aria-label="Share this page"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
      <path d="M22 2 11 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      <path d="M22 2 15 22l-4-9-9-4 20-7Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </button>
) : (
  <button
    type="button"
    class="share-trigger inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-green text-brand-dark shadow-sm transition hover:opacity-90"
    aria-label={label}
    title={label}
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
      <path d="M22 2 11 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      <path d="M22 2 15 22l-4-9-9-4 20-7Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </button>
)}

{renderSingleton && (
  <div
    id="share-popover"
    class="pointer-events-none fixed inset-0 z-[60] flex items-end justify-center bg-brand-dark/40 opacity-0 transition-opacity duration-200 sm:items-center"
    aria-hidden="true"
  >
    <div class="w-full max-w-sm -translate-y-2 rounded-t-2xl bg-white p-5 shadow-xl transition-transform duration-200 sm:-translate-y-0 sm:rounded-2xl">
      <div class="flex items-center justify-between">
        <h2 class="font-bold text-brand-dark">Share this page</h2>
        <button type="button" id="share-popover-close" aria-label="Close" class="rounded-md p-1 text-slate-400 hover:bg-slate-100 hover:text-brand-dark">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
        </button>
      </div>
      <div class="mt-4 grid grid-cols-4 gap-3 text-center">
        <a id="share-whatsapp" href="#" target="_blank" rel="noopener" class="flex flex-col items-center gap-1.5 text-xs font-medium text-slate-600">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-[#25D366] text-white">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2Zm5.8 14.02c-.24.68-1.4 1.3-1.93 1.37-.5.07-1.03.31-3.45-.72-2.9-1.23-4.76-4.2-4.9-4.4-.15-.19-1.17-1.56-1.17-2.97s.73-2.1 1-2.39c.24-.26.53-.32.7-.32.18 0 .35 0 .5.01.16.01.38-.06.6.45.24.57.8 1.98.87 2.12.07.15.11.32.02.51-.09.19-.14.31-.27.48-.14.17-.29.37-.41.5-.14.14-.28.29-.12.57.16.28.71 1.17 1.53 1.89 1.05.93 1.93 1.22 2.21 1.36.28.14.44.12.6-.07.17-.19.71-.83.9-1.11.19-.28.38-.24.63-.15.26.1 1.65.78 1.93.92.28.14.47.21.54.33.07.12.07.68-.17 1.36Z"></path></svg>
          </span>
          WhatsApp
        </a>
        <a id="share-email" href="#" class="flex flex-col items-center gap-1.5 text-xs font-medium text-slate-600">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-500 text-white">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="2"></rect><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </span>
          Email
        </a>
        <a id="share-facebook" href="#" target="_blank" rel="noopener" class="flex flex-col items-center gap-1.5 text-xs font-medium text-slate-600">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-[#1877F2] text-white">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7.5H16l.5-3.5h-3V7.8c0-1 .3-1.8 1.8-1.8H16.5V2.9c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3V10H7v3.5h2.8V21h3.7Z"></path></svg>
          </span>
          Facebook
        </a>
        <button type="button" id="share-copy" class="flex flex-col items-center gap-1.5 text-xs font-medium text-slate-600">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-brand-dark text-white">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M10 13a5 5 0 0 0 7.07 0l2.83-2.83a5 5 0 0 0-7.07-7.07L11 4.93M14 11a5 5 0 0 0-7.07 0L4.1 13.83a5 5 0 0 0 7.07 7.07L13 19.07" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </span>
          <span id="share-copy-label">Copy Link</span>
        </button>
      </div>
    </div>
  </div>
)}

{renderSingleton && (
  <script>
    const popover = document.getElementById('share-popover') as HTMLDivElement;
    const closeBtn = document.getElementById('share-popover-close') as HTMLButtonElement;
    const whatsapp = document.getElementById('share-whatsapp') as HTMLAnchorElement;
    const email = document.getElementById('share-email') as HTMLAnchorElement;
    const facebook = document.getElementById('share-facebook') as HTMLAnchorElement;
    const copyBtn = document.getElementById('share-copy') as HTMLButtonElement;
    const copyLabel = document.getElementById('share-copy-label') as HTMLSpanElement;

    function openPopover() {
      const url = window.location.href;
      const title = document.title;

      whatsapp.href = `https://wa.me/?text=${encodeURIComponent(`${title} ${url}`)}`;
      email.href = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(url)}`;
      facebook.href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;

      popover.classList.remove('pointer-events-none', 'opacity-0');
      popover.setAttribute('aria-hidden', 'false');
    }

    function closePopover() {
      popover.classList.add('pointer-events-none', 'opacity-0');
      popover.setAttribute('aria-hidden', 'true');
    }

    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest('.share-trigger');
      if (!trigger) return;

      const shareData = { title: document.title, url: window.location.href };
      if (navigator.share && navigator.canShare?.(shareData) !== false) {
        navigator.share(shareData).catch(() => {});
      } else {
        openPopover();
      }
    });

    closeBtn.addEventListener('click', closePopover);
    popover.addEventListener('click', (e) => {
      if (e.target === popover) closePopover();
    });

    copyBtn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(window.location.href);
      copyLabel.textContent = 'Copied!';
      setTimeout(() => (copyLabel.textContent = 'Copy Link'), 1500);
    });
  </script>
)}
