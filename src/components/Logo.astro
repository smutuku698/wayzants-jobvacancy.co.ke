---
interface Props {
  dark?: boolean;
  class?: string;
}
const { dark = false, class: className = '' } = Astro.props;
---

<a href="/" class={`flex items-center gap-2.5 shrink-0 ${className}`} aria-label="JobVacancy.co.ke home">
  <svg viewBox="0 0 32 32" width="34" height="34" class="shrink-0">
    <rect width="32" height="32" rx="7" fill="var(--color-brand-dark)"></rect>
    <path
      d="M11.5 10.5V9a2 2 0 0 1 2-2h5a2 2 0 0 1 2 2v1.5"
      stroke="var(--color-brand-orange)"
      stroke-width="1.8"
      fill="none"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <rect x="6.5" y="10.5" width="19" height="13" rx="2.4" fill="var(--color-cream)"></rect>
    <rect x="6.5" y="10.5" width="19" height="5.4" rx="2.4" fill="var(--color-brand-orange)"></rect>
    <rect x="14" y="14.3" width="4" height="4" rx="0.8" fill="var(--color-brand-dark)"></rect>
  </svg>
  <span class={`text-lg font-extrabold leading-none tracking-tight ${dark ? 'text-white' : 'text-brand-dark'}`}>
    Job<span class="text-brand-orange">Vacancy</span><span class={dark ? 'text-white/60' : 'text-slate-400'}
      >.co.ke</span
    >
  </span>
</a>
