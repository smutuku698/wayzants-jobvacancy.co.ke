---
import Logo from './Logo.astro';
import { TOP_NAV_CATEGORIES, TOP_NAV_LOCATIONS } from '../lib/taxonomy';
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-brand-dark">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <Logo dark />

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      <div class="group relative">
        <button
          class="flex items-center gap-1 rounded-md px-3 py-2 text-sm font-semibold text-white/85 hover:bg-white/10 hover:text-white"
        >
          Jobs by Category
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
        <div
          class="invisible absolute left-0 top-full z-10 w-64 rounded-lg border border-slate-200 bg-white p-2 opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100"
        >
          {TOP_NAV_CATEGORIES.map((c) => (
            <a href={`/category/${c.slug}/`} class="block rounded-md px-3 py-2 text-sm text-brand-dark hover:bg-cream">{c.name}</a>
          ))}
          <a href="/jobs/" class="mt-1 block rounded-md border-t border-slate-100 px-3 py-2 text-sm font-semibold text-brand-orange">View all categories &rarr;</a>
        </div>
      </div>

      <div class="group relative">
        <button
          class="flex items-center gap-1 rounded-md px-3 py-2 text-sm font-semibold text-white/85 hover:bg-white/10 hover:text-white"
        >
          Jobs by Location
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
        <div
          class="invisible absolute left-0 top-full z-10 w-56 rounded-lg border border-slate-200 bg-white p-2 opacity-0 shadow-lg transition group-hover:visible group-hover:opacity-100"
        >
          {TOP_NAV_LOCATIONS.map((l) => (
            <a href={`/location/${l.slug}/`} class="block rounded-md px-3 py-2 text-sm text-brand-dark hover:bg-cream">{l.name}</a>
          ))}
          <a href="/location/remote-online-kenya/" class="block rounded-md px-3 py-2 text-sm text-brand-dark hover:bg-cream">Remote / Online</a>
        </div>
      </div>

      <a href="/location/international-remote/" class="rounded-md px-3 py-2 text-sm font-semibold text-white/85 hover:bg-white/10 hover:text-white">
        International Jobs
      </a>
      <a href="/jobs/" class="rounded-md px-3 py-2 text-sm font-semibold text-white/85 hover:bg-white/10 hover:text-white">
        All Jobs
      </a>
      <a href="/cv-and-resume-services/" class="rounded-md px-3 py-2 text-sm font-semibold text-white/85 hover:bg-white/10 hover:text-white">
        CV Services
      </a>
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a href="/post-a-job/" class="btn-primary !py-2 !px-4 text-sm">Post a Job</a>
    </div>

    <details class="group lg:hidden">
      <summary class="flex list-none items-center justify-center rounded-md p-2 text-white hover:bg-white/10">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="group-open:hidden"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="hidden group-open:block"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      </summary>
      <div class="absolute inset-x-0 top-full border-t border-white/10 bg-brand-dark px-4 pb-4 lg:hidden">
        <p class="mt-3 mb-1 text-xs font-semibold uppercase tracking-wide text-white/50">Categories</p>
        {TOP_NAV_CATEGORIES.map((c) => (
          <a href={`/category/${c.slug}/`} class="block rounded-md px-2 py-2 text-sm text-white/90 hover:bg-white/10">{c.name}</a>
        ))}
        <a href="/jobs/" class="block rounded-md px-2 py-2 text-sm font-semibold text-brand-orange">View all categories &rarr;</a>
        <p class="mt-3 mb-1 text-xs font-semibold uppercase tracking-wide text-white/50">Locations</p>
        {TOP_NAV_LOCATIONS.map((l) => (
          <a href={`/location/${l.slug}/`} class="block rounded-md px-2 py-2 text-sm text-white/90 hover:bg-white/10">{l.name}</a>
        ))}
        <a href="/location/international-remote/" class="block rounded-md px-2 py-2 text-sm text-white/90 hover:bg-white/10">International Jobs</a>
        <a href="/jobs/" class="block rounded-md px-2 py-2 text-sm text-white/90 hover:bg-white/10">All Jobs</a>
        <a href="/cv-and-resume-services/" class="block rounded-md px-2 py-2 text-sm text-white/90 hover:bg-white/10">CV &amp; Resume Services</a>
        <a href="/post-a-job/" class="btn-primary mt-3 w-full !py-2.5 text-sm">Post a Job</a>
      </div>
    </details>
  </div>
</header>
