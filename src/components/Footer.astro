---
import Logo from './Logo.astro';
import { NAV_CATEGORIES, NAV_LOCATIONS } from '../lib/taxonomy';
---

<footer class="bg-brand-dark pt-14 pb-8 text-white/70">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="grid grid-cols-1 gap-10 border-b border-white/10 pb-10 md:grid-cols-4">
      <div>
        <Logo dark />
        <p class="mt-4 text-sm leading-relaxed text-white/60">
          Kenya's job board for NGO, government, teaching and online jobs. New vacancies added daily across
          Nairobi, Mombasa, Kisumu, Eldoret, Nakuru and beyond.
        </p>
      </div>
      <div>
        <h4 class="text-sm font-bold text-white">For Job Seekers</h4>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="/jobs/" class="hover:text-white">Browse All Jobs</a></li>
          <li><a href="/category/online-remote-jobs/" class="hover:text-white">Online &amp; Remote Jobs</a></li>
          <li><a href="/location/international-remote/" class="hover:text-white">International Jobs</a></li>
          <li><a href="/category/internships-graduate-trainee/" class="hover:text-white">Internships</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-sm font-bold text-white">For Employers</h4>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="/post-a-job/" class="hover:text-white">Post a Job — It's Free</a></li>
          <li><a href="/contact/" class="hover:text-white">Contact Us</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-sm font-bold text-white">Company</h4>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="/about/" class="hover:text-white">About Us</a></li>
          <li><a href="/contact/" class="hover:text-white">Contact</a></li>
          <li><a href="/privacy-policy/" class="hover:text-white">Privacy Policy</a></li>
          <li><a href="/terms/" class="hover:text-white">Terms of Use</a></li>
        </ul>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-8 border-b border-white/10 py-10 md:grid-cols-2">
      <div>
        <h4 class="mb-3 text-xs font-bold uppercase tracking-wide text-white">Jobs by Category</h4>
        <div class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
          {NAV_CATEGORIES.map((c) => (
            <a href={`/category/${c.slug}/`} class="truncate hover:text-white">{c.name}</a>
          ))}
        </div>
      </div>
      <div>
        <h4 class="mb-3 text-xs font-bold uppercase tracking-wide text-white">Jobs by Location</h4>
        <div class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
          {NAV_LOCATIONS.map((l) => (
            <a href={`/location/${l.slug}/`} class="truncate hover:text-white">{l.name}</a>
          ))}
        </div>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between gap-3 pt-6 text-xs text-white/50 sm:flex-row">
      <p>&copy; {new Date().getFullYear()} JobVacancy.co.ke — All Rights Reserved.</p>
      <div class="h-1.5 w-24 overflow-hidden rounded-full flex">
        <span class="flex-1 bg-black"></span>
        <span class="flex-1 bg-red-600"></span>
        <span class="flex-1 bg-white"></span>
        <span class="flex-1 bg-brand-green"></span>
      </div>
    </div>
  </div>
</footer>
