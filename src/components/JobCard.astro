---
import type { JobWithRelations } from '../lib/types';
import { formatSalary, locationLabel, timeAgo } from '../lib/format';
import { jobTypeLabel } from '../lib/seo';

interface Props {
  job: JobWithRelations;
}
const { job } = Astro.props;
const salary = formatSalary(job);
---

<a
  href={`/jobs/${job.slug}/`}
  class="card group flex flex-col gap-3 p-4 transition hover:-translate-y-0.5 hover:border-brand-orange hover:shadow-md sm:p-5"
>
  <div class="flex gap-4">
    <div class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-cream ring-1 ring-slate-200 sm:h-14 sm:w-14">
      {job.company_logo_url ? (
        <img src={job.company_logo_url} alt={`${job.company_name} logo`} width="56" height="56" loading="lazy" class="h-full w-full object-cover" />
      ) : (
        <span class="text-lg font-bold text-brand-dark/40">{job.company_name.charAt(0)}</span>
      )}
    </div>
    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-2">
        <h3 class="truncate text-base font-bold text-brand-dark group-hover:text-brand-orange sm:text-lg">{job.title}</h3>
        {job.is_international && <span class="badge shrink-0 bg-brand-orange/10 text-brand-orange">International</span>}
      </div>
      <p class="mt-0.5 truncate text-sm font-medium text-slate-600">{job.company_name}</p>
      <div class="mt-2 flex flex-wrap items-center gap-2 text-xs text-slate-500">
        <span class={`inline-flex items-center gap-1 font-medium ${job.is_remote || job.is_international ? 'text-brand-green-dark' : 'text-slate-600'}`}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="shrink-0"><path d="M12 21s-7-6.1-7-11a7 7 0 1 1 14 0c0 4.9-7 11-7 11Z" stroke="currentColor" stroke-width="1.6"></path><circle cx="12" cy="10" r="2.4" stroke="currentColor" stroke-width="1.6"></circle></svg>
          {locationLabel(job)}
        </span>
        <span class="badge bg-brand-dark/5 text-brand-dark">{jobTypeLabel(job.job_type)}</span>
        {salary && (
          <span class="inline-flex items-center gap-1 font-semibold text-brand-green-dark">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" class="shrink-0"><path d="M12 3v18M17 7.5c0-1.9-2.2-3.5-5-3.5S7 5.6 7 7.5 9.2 11 12 11s5 1.6 5 3.5-2.2 3.5-5 3.5-5-1.6-5-3.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg>
            {salary}
          </span>
        )}
      </div>
    </div>
  </div>

  <div class="flex items-center gap-3 border-t border-border pt-2.5 text-[11px] text-slate-400">
    <span class="inline-flex items-center gap-1 font-medium text-slate-500">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" class="shrink-0"><path d="m5 13 4 4L19 7" stroke="var(--color-brand-green-dark)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      Verified listing
    </span>
    <span class="truncate text-slate-400">{job.job_categories?.name}</span>
    <span class="ml-auto shrink-0">{timeAgo(job.created_at)}</span>
  </div>
</a>
